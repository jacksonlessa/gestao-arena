# Ambiente: development | production
NODE_ENV=development

# Porta do backend
PORT=3001

# Conexão MySQL. Em desenvolvimento aponta para o contêiner do docker-compose
# (porta 3307 no host, para não colidir com um MySQL já instalado na máquina).
DATABASE_URL="mysql://arena:arena@localhost:3307/gestao_arena"

# Em produção o MySQL é compartilhado com outras aplicações do droplet.
# `connection_limit` é obrigatório ali: o padrão do Prisma é dimensionado pelo
# número de CPUs e, somado aos outros backends, esgota o max_connections do
# servidor — o que derruba todas as aplicações, não só esta.
# DATABASE_URL="mysql://USUARIO:SENHA@localhost:3306/gestao_arena?connection_limit=5"

# Origens permitidas no CORS, declaradas POR SUPERFÍCIE.
# Nunca use curinga: com credentials habilitado o navegador recusa.
CORS_ORIGIN_OPERACAO="http://arenas.localhost:3000"
CORS_ORIGIN_BACKOFFICE="http://backoffice-arenas.localhost:3000"

# Identificação exibida no healthcheck
APP_NAME="gestao-arena-api"
APP_VERSION="0.1.0"
