# Hosts das duas superfícies. O middleware usa estes valores para decidir qual
# aplicação servir e para recusar o caminho físico do outro host.
#
# Em desenvolvimento usamos subdomínios de .localhost, que resolvem para
# 127.0.0.1 automaticamente nos navegadores modernos — sem mexer em /etc/hosts.
NEXT_PUBLIC_HOST_OPERACAO=arenas.localhost
NEXT_PUBLIC_HOST_BACKOFFICE=backoffice-arenas.localhost

# Em produção:
# NEXT_PUBLIC_HOST_OPERACAO=arenas.entretimes.com.br
# NEXT_PUBLIC_HOST_BACKOFFICE=backoffice-arenas.entretimes.com.br

# URL do backend. Domínio próprio, não reescrita — as três superfícies
# compartilham o domínio registrável, então as requisições são same-site.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Em produção:
# NEXT_PUBLIC_API_URL=https://arenas-api.entretimes.com.br
